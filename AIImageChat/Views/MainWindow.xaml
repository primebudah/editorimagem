<Window x:Class="AIImageChat.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AIImageChat.Views"
        mc:Ignorable="d"
        Title="AI Image Chat"
        Height="700"
        Width="1000"
        MinHeight="500"
        MinWidth="800"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="MainWindow_Drop"
        DragEnter="MainWindow_DragEnter"
        DragLeave="MainWindow_DragLeave">
    
    <Window.Resources>
        <!-- DataTemplate para mensagens do usuário -->
        <DataTemplate x:Key="UserMessageTemplate">
            <StackPanel Margin="10,5" HorizontalAlignment="Right">
                <Border Background="{StaticResource AccentColor}"
                        CornerRadius="8"
                        Padding="12,8"
                        MaxWidth="600">
                    <TextBlock Text="{Binding Text}"
                               Foreground="White"
                               TextWrapping="Wrap"
                               FontSize="14"/>
                </Border>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                           Foreground="{StaticResource SecondaryForegroundColor}"
                           FontSize="11"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Right"/>
            </StackPanel>
        </DataTemplate>

        <!-- DataTemplate para mensagens da IA -->
        <DataTemplate x:Key="AssistantMessageTemplate">
            <StackPanel Margin="10,5" HorizontalAlignment="Left">
                <Border Background="{StaticResource SecondaryBackgroundColor}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12,8"
                        MaxWidth="600">
                    <StackPanel>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{StaticResource ForegroundColor}"
                                   TextWrapping="Wrap"
                                   FontSize="14"/>
                        
                        <!-- Imagem gerada -->
                        <Image Source="{Binding ImagePath}"
                               Stretch="Uniform"
                               MaxWidth="550"
                               MaxHeight="400"
                               Margin="0,8,0,0"
                               Cursor="Hand"
                               MouseLeftButtonUp="Image_MouseLeftButtonUp"/>
                        
                        <!-- Indicador de otimização -->
                        <TextBlock Text="✓ Resultado otimizado automaticamente"
                                   Foreground="{StaticResource SuccessColor}"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding WasOptimized, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm}'}"
                           Foreground="{StaticResource SecondaryForegroundColor}"
                           FontSize="11"
                           Margin="0,2,0,0"
                           HorizontalAlignment="Left"/>
            </StackPanel>
        </DataTemplate>

        <!-- DataTemplate para mensagens do sistema -->
        <DataTemplate x:Key="SystemMessageTemplate">
            <StackPanel Margin="10,5" HorizontalAlignment="Center">
                <Border Background="{StaticResource TertiaryBackgroundColor}"
                        CornerRadius="8"
                        Padding="12,8"
                        MaxWidth="600">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{StaticResource WarningColor}"
                               TextWrapping="Wrap"
                               FontSize="13"
                               FontStyle="Italic"
                               TextAlignment="Center"/>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- DataTemplate para imagens selecionadas -->
        <DataTemplate x:Key="SelectedImageTemplate">
            <Border Background="{StaticResource SecondaryBackgroundColor}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8"
                    Margin="4">
                <StackPanel Width="150">
                    <Image Source="{Binding FilePath}"
                           Stretch="Uniform"
                           Height="100"
                           Margin="0,0,0,8"/>
                    
                    <TextBlock Text="{Binding FileName}"
                               Foreground="{StaticResource ForegroundColor}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FileName}"/>
                    
                    <TextBlock Text="{Binding FormattedResolution}"
                               Foreground="{StaticResource SecondaryForegroundColor}"
                               FontSize="10"/>
                    
                    <TextBlock Text="{Binding FormattedFileSize}"
                               Foreground="{StaticResource SecondaryForegroundColor}"
                               FontSize="10"/>
                    
                    <Button Content="✕"
                            Background="Transparent"
                            Foreground="{StaticResource SecondaryForegroundColor}"
                            BorderThickness="0"
                            FontSize="12"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0"
                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{StaticResource SecondaryBackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <TextBlock Text="AI Image Chat"
                           Style="{StaticResource TitleStyle}"
                           Foreground="{StaticResource ForegroundColor}"/>
                
                <Button Content="⚙"
                        Background="Transparent"
                        Foreground="{StaticResource ForegroundColor}"
                        BorderThickness="0"
                        FontSize="20"
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Right"
                        Command="{Binding OpenSettingsCommand}"
                        Cursor="Hand"
                        ToolTip="Configurações"/>
            </Grid>
        </Border>

        <!-- Área Central - Conversa -->
        <ScrollViewer Grid.Row="1"
                      x:Name="ChatScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ModernScrollViewer}">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplateSelector>
                    <local:MessageTemplateSelector 
                        UserTemplate="{StaticResource UserMessageTemplate}"
                        AssistantTemplate="{StaticResource AssistantMessageTemplate}"
                        SystemTemplate="{StaticResource SystemMessageTemplate}"/>
                </ItemsControl.ItemTemplateSelector>
            </ItemsControl>
        </ScrollViewer>

        <!-- Área Inferior - Input -->
        <Border Grid.Row="2"
                Background="{StaticResource SecondaryBackgroundColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0"
                Padding="16">
            <StackPanel>
                <!-- Imagens selecionadas -->
                <ItemsControl ItemsSource="{Binding SelectedImages}"
                              ItemTemplate="{StaticResource SelectedImageTemplate}"
                              Visibility="{Binding SelectedImages.Count, Converter={StaticResource CountToVisibilityConverter}}"
                              Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Área de input -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Botão de anexar imagem -->
                    <Button Grid.Column="0"
                            Content="📎"
                            Background="{StaticResource TertiaryBackgroundColor}"
                            Foreground="{StaticResource ForegroundColor}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderColor}"
                            Width="44"
                            Height="44"
                            Margin="0,0,8,0"
                            Command="{Binding SelectImageCommand}"
                            Cursor="Hand"
                            ToolTip="Escolher imagem"/>

                    <!-- Caixa de texto -->
                    <TextBox Grid.Column="1"
                             Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="44"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Padding="12">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SendCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Botão de enviar -->
                    <Button Grid.Column="2"
                            Content="Enviar"
                            Style="{StaticResource AccentButtonStyle}"
                            Width="80"
                            Height="44"
                            Margin="8,0,0,0"
                            Command="{Binding SendCommand}"
                            Cursor="Hand"/>
                </Grid>

                <!-- Status de processamento -->
                <Border Background="{StaticResource TertiaryBackgroundColor}"
                        CornerRadius="4"
                        Padding="12,8"
                        Margin="0,12,0,0"
                        Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding ProcessingStatus}"
                                       Foreground="{StaticResource ForegroundColor}"
                                       FontSize="13"/>
                            <Button Content="Cancelar"
                                    Background="Transparent"
                                    Foreground="{StaticResource AccentColor}"
                                    BorderThickness="0"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CancelCommand}"
                                    Cursor="Hand"
                                    FontSize="12"/>
                        </Grid>
                        
                        <!-- Barra de progresso -->
                        <ProgressBar Value="{Binding ProcessingProgress}"
                                     Maximum="100"
                                     Height="4"
                                     Margin="0,8,0,0"
                                     Foreground="{StaticResource AccentColor}"
                                     Background="{StaticResource BorderColor}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
