<Window x:Class="AIImageChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Configurações"
        Height="450"
        Width="500"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterOwner">
    
    <Border Padding="24">
        <StackPanel>
            <TextBlock Text="Configurações"
                       Style="{StaticResource TitleStyle}"
                       Margin="0,0,0,24"/>

            <!-- OpenAI API Key -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="OpenAI API Key"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="36"
                             FontSize="13"/>
                <TextBlock Text="Sua API Key será salva de forma criptografada"
                           Foreground="{StaticResource SecondaryForegroundColor}"
                           FontSize="11"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- OpenAI Model -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Modelo OpenAI"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,8"/>
                <ComboBox x:Name="ModelComboBox"
                          Height="36"
                          FontSize="13"
                          Background="{StaticResource SecondaryBackgroundColor}"
                          Foreground="{StaticResource ForegroundColor}"
                          BorderBrush="{StaticResource BorderColor}">
                    <ComboBoxItem Content="gpt-5.5" IsSelected="True"/>
                </ComboBox>
            </StackPanel>

            <!-- Max Retry Attempts -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="Número máximo de tentativas automáticas"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="Retry1Radio"
                                 Content="1"
                                 GroupName="RetryAttempts"
                                 Margin="0,0,16,0"
                                 Foreground="{StaticResource ForegroundColor}"/>
                    <RadioButton x:Name="Retry2Radio"
                                 Content="2"
                                 GroupName="RetryAttempts"
                                 Margin="0,0,16,0"
                                 IsChecked="True"
                                 Foreground="{StaticResource ForegroundColor}"/>
                    <RadioButton x:Name="Retry3Radio"
                                 Content="3"
                                 GroupName="RetryAttempts"
                                 Foreground="{StaticResource ForegroundColor}"/>
                </StackPanel>
            </StackPanel>

            <!-- Auto Evaluate Results -->
            <StackPanel Margin="0,0,0,16">
                <CheckBox x:Name="AutoEvaluateCheckBox"
                          Content="Autoavaliar resultados automaticamente"
                          IsChecked="True"
                          Foreground="{StaticResource ForegroundColor}"
                          FontSize="14"/>
                <TextBlock Text="O aplicativo fará uma segunda análise para verificar a qualidade"
                           Foreground="{StaticResource SecondaryForegroundColor}"
                           FontSize="11"
                           Margin="24,4,0,0"/>
            </StackPanel>

            <!-- Save API Key Encrypted -->
            <StackPanel Margin="0,0,0,16">
                <CheckBox x:Name="SaveEncryptedCheckBox"
                          Content="Salvar API Key localmente de forma criptografada"
                          IsChecked="True"
                          Foreground="{StaticResource ForegroundColor}"
                          FontSize="14"/>
            </StackPanel>

            <!-- Default Export Folder -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Pasta padrão de exportação"
                           Style="{StaticResource SubtitleStyle}"
                           Margin="0,0,0,8"/>
                <Grid>
                    <TextBox x:Name="ExportFolderTextBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             Height="36"
                             IsReadOnly="True"
                             FontSize="13"/>
                    <Button Content="..."
                            Width="44"
                            Height="36"
                            HorizontalAlignment="Right"
                            Background="{StaticResource TertiaryBackgroundColor}"
                            Foreground="{StaticResource ForegroundColor}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource BorderColor}"
                            Click="BrowseFolder_Click"
                            Cursor="Hand"/>
                </Grid>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="100"
                        Height="36"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Salvar"
                        Style="{StaticResource AccentButtonStyle}"
                        Width="100"
                        Height="36"
                        Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
